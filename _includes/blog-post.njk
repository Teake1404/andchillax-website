<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — And Chillax</title>
  <meta name="description" content="{{ description }}">
  {% if keywords %}<meta name="keywords" content="{{ keywords }}">{% endif %}
  <link rel="canonical" href="https://andchillax.co.uk{{ page.url | replace('.html', '') }}">
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="stylesheet" href="/assets/style.css?v=7">

  {# Resolve image URL — supports both CMS uploads (bare filename → /assets/uploads/foo.jpg)
     AND existing site images (full path → /assets/images/foo.jpg used as-is).
     If no image is uploaded, fall back to a category-appropriate default so
     the post never looks bare and always has a social-share preview image. #}
  {% if image %}
    {% if image[0] == '/' %}{% set imagePath = image %}{% else %}{% set imagePath = '/assets/uploads/' + image %}{% endif %}
  {% elif category == 'Doula' or category == 'Birth' %}{% set imagePath = '/assets/images/blog-doula.jpg' %}
  {% elif category == 'First Aid' %}{% set imagePath = '/assets/images/blog-infant-cpr.jpg' %}
  {% elif category == 'Childhood Illness' %}{% set imagePath = '/assets/images/blog-febrile.jpg' %}
  {% else %}{% set imagePath = '/assets/images/photo-newborn.jpg' %}{% endif %}
  {% set imageAbsolute = 'https://andchillax.co.uk' + imagePath %}
  {% set ogImage = imageAbsolute %}

  {# Open Graph + Twitter Card — so Instagram/Facebook/WhatsApp shares show a proper preview #}
  <meta property="og:type" content="article">
  <meta property="og:title" content="{{ title }} — And Chillax">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="https://andchillax.co.uk{{ page.url | replace('.html', '') }}">
  <meta property="og:image" content="{{ ogImage }}">
  <meta property="og:site_name" content="And Chillax">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="{{ ogImage }}">

  {# Article schema for SEO #}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "{{ title | safe }}",
    "author": {
      "@type": "Person",
      "name": "Eva Levinson"
    },
    "datePublished": "{{ date | date('iso') }}",
    "publisher": {
      "@type": "Organization",
      "name": "And Chillax"
    },
    "image": "{{ imageAbsolute }}"
  }
  </script>

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-FNJRJ2P3NN"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag("js", new Date());
    gtag("config", "G-FNJRJ2P3NN");
  </script>
</head>
<body>

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand">And Chillax</a>
    <button class="site-header__menu-toggle" aria-label="Toggle navigation menu" aria-expanded="false" type="button">
      <span class="site-header__menu-toggle__icon"><span></span><span></span><span></span></span>
    </button>
    <nav class="nav" aria-label="Main">
      <a href="/courses/">First Aid Courses</a>
      <a href="/baby-massage">Baby Massage</a>
      <a href="/doula-services">Doula</a>
      <a href="/blog/" class="active">Blog</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <a href="https://www.instagram.com/andchillax/" target="_blank" rel="noopener" aria-label="Instagram" style="display:inline-flex;align-items:center;font-size:1.25rem;text-decoration:none">📷</a>
      <a href="https://bookwhen.com/andchillax" class="nav__cta">Book a Course →</a>
    </nav>
  </div>
</header>

<div class="container">
  <nav class="breadcrumb"><a href="/">Home</a> · <a href="/blog/">Blog</a> · <span>{{ title }}</span></nav>
</div>

<article>

  <header class="article-header">
    <div class="container container--narrow">
      <p class="article-header__category">{{ category }} · {{ reading_time }} minute read</p>
      <h1 class="article-header__title">{{ title }}</h1>
      <p class="article-header__meta">By Eva Levinson · Updated {{ date | date('human') }}</p>
    </div>
  </header>

  {% if imagePath %}
  <div class="container container--narrow">
    <div class="article-image">
      <img src="{{ imagePath }}" alt="{{ image_alt or title }}" loading="eager" style="width:100%; height:100%; object-fit:cover; position:absolute; inset:0; border-radius: var(--radius-lg);">
    </div>
  </div>
  {% endif %}

  <div class="container container--narrow">
    <div class="article">
      {{ content | safe }}

      {% if cta_course == "12-Hour Paediatric Blended" %}
      <div class="cta-box">
        <h3 class="cta-box__title">Need full Ofsted certification?</h3>
        <p class="cta-box__desc">My 12-Hour Paediatric First Aid (Blended) is the full Ofsted-compliant Level 3 qualification — 6 hours online + one day in our Anerley classroom. £90/person or £700 for groups of up to 14.</p>
        <a href="/courses/12-hour-paediatric-first-aid" class="btn btn--primary">See the 12-Hour Course<span class="btn__arrow">→</span></a>
      </div>
      {% elif cta_course == "2-Hour Parent First Aid" %}
      <div class="cta-box">
        <h3 class="cta-box__title">Practise this on a real-feel manikin</h3>
        <p class="cta-box__desc">My 2-Hour Parent First Aid course covers infant CPR, choking, fevers and recovery position — in your home or your NCT group's. Two hours, £150 for up to 6 people.</p>
        <a href="/courses/2-hour-parent-first-aid" class="btn btn--primary">Book the 2-Hour Parent Course<span class="btn__arrow">→</span></a>
      </div>
      {% elif cta_course == "1-Day EFAW" %}
      <div class="cta-box">
        <h3 class="cta-box__title">First aid for your workplace</h3>
        <p class="cta-box__desc">My 1-Day Emergency First Aid at Work is HSE-compliant Level 3 — perfect for cafés, gyms, salons and small offices. £90/person or £700 for groups up to 14.</p>
        <a href="/courses/1-day-emergency-first-aid-at-work" class="btn btn--primary">See the EFAW Course<span class="btn__arrow">→</span></a>
      </div>
      {% elif cta_course == "Doula Services" %}
      <div class="cta-box">
        <h3 class="cta-box__title">Want a doula on the journey with you?</h3>
        <p class="cta-box__desc">I'm a Doula UK trained postnatal doula and Postnatal Midwifery Assistant &amp; Infant Feeding Specialist for the NHS, based in Anerley. Free 30-minute discovery call — no commitment.</p>
        <a href="/doula-services" class="btn btn--primary">Learn about my doula services<span class="btn__arrow">→</span></a>
      </div>
      {% endif %}

      <p style="margin-top:3rem; padding-top:2rem; border-top:1px solid var(--colour-border); font-size: var(--fs-sm); color: var(--colour-text-muted)">Eva Levinson is a part-time Postnatal Midwifery Assistant &amp; Infant Feeding Specialist for the NHS, a Doula UK trained postnatal doula, and an Ofsted/HSE compliant first aid instructor. She runs And Chillax in Anerley, South London.</p>
    </div>
  </div>
</article>

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col footer-brand">
        <h4>And Chillax</h4>
        <p>Warm, fear-free first aid training, baby massage and doula support across South London.</p>
      </div>
      <div class="footer-col">
        <h4>Courses</h4>
        <ul>
          <li><a href="/courses/12-hour-paediatric-first-aid">12-Hour Paediatric</a></li>
          <li><a href="/courses/2-hour-parent-first-aid">Parent First Aid</a></li>
          <li><a href="/courses/1-day-emergency-first-aid-at-work">1-Day EFAW</a></li>
          <li><a href="/courses/">All courses →</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Services</h4>
        <ul>
          <li><a href="/baby-massage">Baby Massage</a></li>
          <li><a href="/doula-services">Doula Services</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/reviews">Reviews</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Contact</h4>
        <ul>
          <li><a href="tel:+447950222958">07950 222958</a></li>
          <li><a href="mailto:eva@andchillax.co.uk">eva@andchillax.co.uk</a></li>
          <li>Croydon Rd, Anerley, SE20 7AB</li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 And Chillax · Eva Levinson</span>
      <span>Serving Anerley · Crystal Palace · Penge · Sydenham · Beckenham · Bromley · Dulwich</span>
      <a href="https://www.instagram.com/andchillax/" target="_blank" rel="noopener" aria-label="Follow And Chillax on Instagram">Instagram → @andchillax</a>
    </div>
  </div>
</footer>

<script>
document.addEventListener('click', function (e) {
  var btn = e.target.closest('.site-header__menu-toggle');
  if (btn) {
    var hdr = btn.closest('.site-header');
    var open = hdr.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    return;
  }
  var link = e.target.closest('.nav a');
  if (link) {
    var hdr2 = link.closest('.site-header');
    if (hdr2) { hdr2.classList.remove('is-open'); }
  }
});
</script>
</body>
</html>
