<script>
document.addEventListener('click', function (e) {
  var btn = e.target.closest('.site-header__menu-toggle');
  if (btn) {
    var hdr = btn.closest('.site-header');
    var open = hdr.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    return;
  }
  var link = e.target.closest('.nav a');
  if (link) {
    var hdr2 = link.closest('.site-header');
    if (hdr2) { hdr2.classList.remove('is-open'); }
  }
});
</script>
