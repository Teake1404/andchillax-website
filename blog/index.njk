      {# ============================================================
         CMS-managed posts (newest first via collections.posts).
         Eva publishes new posts at /admin → they auto-appear here.
         Image resolution mirrors blog-post.njk: explicit path wins,
         then bare filename → /assets/uploads/, then category default.
         ============================================================ #}
      {% for post in collections.posts %}
        {% set img = post.data.image %}
        {% if img %}
          {% if img[0] == '/' %}{% set imgPath = img %}{% else %}{% set imgPath = '/assets/uploads/' + img %}{% endif %}
        {% elif post.data.category == 'Doula' or post.data.category == 'Birth' %}{% set imgPath = '/assets/images/blog-doula.jpg' %}
        {% elif post.data.category == 'First Aid' %}{% set imgPath = '/assets/images/blog-infant-cpr.jpg' %}
        {% elif post.data.category == 'Childhood Illness' %}{% set imgPath = '/assets/images/blog-febrile.jpg' %}
        {% else %}{% set imgPath = '/assets/images/photo-newborn.jpg' %}{% endif %}

      <a href="{{ post.url }}" class="blog-card">
        <div class="blog-card__image">
          <img src="{{ imgPath }}" alt="{{ post.data.image_alt or post.data.title }}" loading="lazy">
        </div>
        <div class="blog-card__body">
          <span class="blog-card__category">{{ post.data.category }}</span>
          <h3 class="blog-card__title">{{ post.data.title }}</h3>
          <p class="blog-card__excerpt">{{ post.data.excerpt }}</p>
        </div>
      </a>
      {% endfor %}

